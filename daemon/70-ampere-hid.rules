# SPDX-License-Identifier: GPL-2.0-or-later
#
# Grant the logged-in user access to the hidraw nodes of supported mice, so the
# companion service can query them without root.
#
# The rules list exact product IDs on purpose: hidraw access to a shared vendor
# ID would also cover keyboards and other devices built on the same chip
# (unknown MCHOSE keyboards sit on 3837, for example). For a model that is not
# listed, add its idProduct from `lsusb`.
#
# Install:
#   sudo install -m644 70-ampere-hid.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger --subsystem-match=hidraw
# or run: ./install.sh --udev

# --- Lamzu / Compx receivers ---
# Maya X 8K (373e:001e, wired 001c), Thorn and Maya/Atlantis Compx receivers
# (3554:f50d, f50f, f510), Inca and Paro and Maya Champion (37b0:...)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="373e", ATTRS{idProduct}=="001e", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="373e", ATTRS{idProduct}=="001c", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3554", ATTRS{idProduct}=="f50d", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3554", ATTRS{idProduct}=="f50f", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3554", ATTRS{idProduct}=="f510", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="37b0", ATTRS{idProduct}=="0001", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="37b0", ATTRS{idProduct}=="0007", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="37b0", ATTRS{idProduct}=="000d", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="37b0", ATTRS{idProduct}=="000e", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="37b0", ATTRS{idProduct}=="0010", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="37b0", ATTRS{idProduct}=="0011", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="37b0", ATTRS{idProduct}=="0015", MODE="0660", TAG+="uaccess"

